PORT=3000

# Firebase Service Account (JSON string or path)
FIREBASE_SERVICE_ACCOUNT="{}"
FIREBASE_PROJECT_ID="kma-project-id"

# Cloudflare R2
R2_ACCOUNT_ID="your_account_id"
R2_ACCESS_KEY_ID="your_access_key"
R2_SECRET_ACCESS_KEY="your_secret_key"
R2_BUCKET_NAME="kma-articles"

# Brevo
BREVO_API_KEY="your_brevo_api_key"

# BKMA Manual Bank Transfer Account Details
BKMA_PAYMENT_ACCOUNT_NAME="Kerala Mathematical Association"
BKMA_BANK_NAME="Bank of Baroda"
BKMA_ACCOUNT_NUMBER="92660100000105"
BKMA_IFSC="BARB0DBKOTT"
BKMA_BRANCH="Good Shepherd Road Branch, Kottayam - 686001"

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Trust Proxy Configuration (2 for Cloudflare + Render reverse proxy setup)
TRUST_PROXY=2

# Security & Rate Limiting Configuration (Window in ms, max in request count)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5

PDF_RATE_LIMIT_WINDOW_MS=900000
PDF_RATE_LIMIT_MAX_REQUESTS=5

UPLOAD_RATE_LIMIT_WINDOW_MS=900000
UPLOAD_RATE_LIMIT_MAX_REQUESTS=5

SIGNED_URL_RATE_LIMIT_WINDOW_MS=900000
SIGNED_URL_RATE_LIMIT_MAX_REQUESTS=15

DOWNLOAD_RATE_LIMIT_WINDOW_MS=900000
DOWNLOAD_RATE_LIMIT_MAX_REQUESTS=30

PAYMENT_RATE_LIMIT_WINDOW_MS=900000
PAYMENT_RATE_LIMIT_MAX_REQUESTS=10

ARCHIVE_RATE_LIMIT_WINDOW_MS=900000
ARCHIVE_RATE_LIMIT_MAX_REQUESTS=5

WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX_REQUESTS=100

SEND_VERIFICATION_RATE_LIMIT_WINDOW_MS=900000
SEND_VERIFICATION_RATE_LIMIT_MAX_REQUESTS=5

VERIFY_CODE_RATE_LIMIT_WINDOW_MS=900000
VERIFY_CODE_RATE_LIMIT_MAX_REQUESTS=10

# Admin and Developer Credentials are managed directly in Firestore
# To add a new admin/dev, add a record to the "users" collection with the appropriate role,
# then run the seeding scripts to sync them with Firebase Auth.


